# Application
ENV=development
API_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://ryoko:ryoko@localhost:5434/ryoko?sslmode=disable
# Host port used by the development Docker Compose stack.
POSTGRES_PORT=5434
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_TIME_MINUTES=30
DB_HEALTH_CHECK_PERIOD_SECONDS=60

# Access and refresh tokens
# Replace these example secrets before running outside local development.
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720
REFRESH_TOKEN_CLEANUP_INTERVAL_HOURS=24
REFRESH_COOKIE_SECURE=false

# Password reset
PASSWORD_RESET_PEPPER=replace-with-at-least-32-random-bytes
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_CLEANUP_INTERVAL_HOURS=24

# SMTP
# These defaults are suitable for a local SMTP catcher such as Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ryoko.local
SMTP_REQUIRE_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# OAuth flow
OAUTH_COOKIE_SECRET=replace-with-at-least-32-random-bytes
OAUTH_COOKIE_SECURE=false
OAUTH_FLOW_TTL_MINUTES=10
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH_LOGIN_CODE_TTL_SECONDS=120
OAUTH_CLEANUP_INTERVAL_MINUTES=30
