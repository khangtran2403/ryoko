# Application
ENV=development
API_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://ryoko:ryoko@localhost:5434/ryoko?sslmode=disable
# Host port used by the development Docker Compose stack.
POSTGRES_PORT=5434
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_TIME_MINUTES=30
DB_HEALTH_CHECK_PERIOD_SECONDS=60

# Payments
PAYMENT_PROVIDER=fake
PAYMENT_PENDING_TTL_MINUTES=15
PAYMENT_EXPIRATION_INTERVAL_SECONDS=30
PAYMENT_EXPIRATION_BATCH_SIZE=100
PAYMENT_REFUND_INTERVAL_SECONDS=30
PAYMENT_REFUND_LEASE_SECONDS=300
PAYMENT_REFUND_RUN_TIMEOUT_SECONDS=240
PAYMENT_REFUND_BATCH_SIZE=100
PAYMENT_REFUND_BASE_RETRY_SECONDS=60
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_STALE_AFTER_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=100
PAYMENT_FAKE_CHECKOUT_BASE_URL=http://localhost:3000/payments/fake
PAYMENT_FAKE_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# Required when PAYMENT_PROVIDER=stripe. Keep the secret key on the server only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Access and refresh tokens
# Replace these example secrets before running outside local development.
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720
REFRESH_TOKEN_CLEANUP_INTERVAL_HOURS=24
REFRESH_COOKIE_SECURE=false

# Password reset
PASSWORD_RESET_PEPPER=replace-with-at-least-32-random-bytes
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_CLEANUP_INTERVAL_HOURS=24

# SMTP
# These defaults are suitable for a local SMTP catcher such as Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ryoko.local
SMTP_REQUIRE_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Transactional email outbox
EMAIL_OUTBOX_INTERVAL_SECONDS=10
EMAIL_OUTBOX_LEASE_SECONDS=300
EMAIL_OUTBOX_RUN_TIMEOUT_SECONDS=240
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_BASE_RETRY_SECONDS=60
EMAIL_OUTBOX_RETENTION_DAYS=30
EMAIL_OUTBOX_CLEANUP_INTERVAL_HOURS=24
EMAIL_OUTBOX_CLEANUP_TIMEOUT_SECONDS=30

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# OAuth flow
OAUTH_COOKIE_SECRET=replace-with-at-least-32-random-bytes
OAUTH_COOKIE_SECURE=false
OAUTH_FLOW_TTL_MINUTES=10
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH_LOGIN_CODE_TTL_SECONDS=120
OAUTH_CLEANUP_INTERVAL_MINUTES=30
